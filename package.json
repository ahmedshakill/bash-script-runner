{
    "name": "bash-runner",
    "displayName": "Bash Runner",
    "description": "Run bash commands directly from your editor",
    "version": "0.1.0",
    "publisher": "yourname",
    "engines": {
        "vscode": "^1.60.0"
    },
    "categories": [
        "Other"
    ],
    "main": "./out/extension.js",
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "pretest": "npm run compile && npm run lint",
        "lint": "eslint src --ext ts",
        "test": "node ./out/test/runTest.js"
    },
    "devDependencies": {
        "@types/node": "^16.18.126",
        "@types/vscode": "^1.99.1",
        "@typescript-eslint/eslint-plugin": "^5.62.0",
        "@typescript-eslint/parser": "^5.62.0",
        "@vscode/test-electron": "^2.5.2",
        "eslint": "^8.57.1",
        "typescript": "^4.9.5"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "type": "commonjs",
    "activationEvents": [
        "onLanguage:shellscript"
    ],
    "contributes": {
        "commands": [
            {
                "command": "bash-runner.runCommand",
                "title": "Run Bash Command"
            }
        ],
        "keybindings": [
            {
                "command": "bash-runner.runSelectedCommand",
                "key": "ctrl+enter",
                "when": "editorTextFocus && editorLangId == shellscript"
            }
        ],
        "configuration": {
            "title": "Bash Runner",
            "properties": {
                "bashRunner.createNewTerminal": {
                    "type": "boolean",
                    "default": false,
                    "description": "Create a new terminal for each command instead of reusing existing ones"
                }
            }
        },
        "languages": [
            {
                "id": "shellscript",
                "extensions": [
                    ".sh"
                ],
                "aliases": [
                    "Shell Script",
                    "shellscript",
                    "bash",
                    "sh"
                ]
            }
        ]
    }
}