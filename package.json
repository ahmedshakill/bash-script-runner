{
    "name": "bash-script-runner",
    "displayName": "Bash Script Runner",
    "description": "Run bash commands directly from your editor",
    "version": "0.1.2",
    "publisher": "ahmedshakill",
    "repository": {"url":"https://github.com/ahmedshakill/bash-script-runner.git"},
    "engines": {
        "vscode": "^1.60.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onLanguage:shellscript"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "bash-runner.runCommand",
                "title": "Run Bash Command"
            },
            {
                "command": "bash-runner.runSelectedCommand",
                "title": "Run Selected Bash Command"
            },
            {
                "command": "bash-runner.handleGutterClick",
                "title": "Handle Gutter Click"
            }
        ],
        "keybindings": [
            {
                "command": "bash-runner.runSelectedCommand",
                "key": "ctrl+enter",
                "when": "editorTextFocus && editorLangId == shellscript"
            }
        ],
        "configuration": {
            "title": "Bash Runner",
            "properties": {
                "bashRunner.createNewTerminal": {
                    "type": "boolean",
                    "default": false,
                    "description": "Create a new terminal for each command instead of reusing existing ones"
                }
            }
        },
        "languages": [
            {
                "id": "shellscript",
                "extensions": [
                    ".sh"
                ],
                "aliases": [
                    "Shell Script",
                    "shellscript",
                    "bash",
                    "sh"
                ]
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "pretest": "npm run compile && npm run lint",
        "lint": "eslint src --ext ts",
        "test": "node ./out/test/runTest.js"
    },
    "devDependencies": {
        "@types/node": "^16.11.7",
        "@types/vscode": "^1.60.0",
        "@typescript-eslint/eslint-plugin": "^5.30.0",
        "@typescript-eslint/parser": "^5.30.0",
        "@vscode/test-electron": "^2.1.5",
        "eslint": "^8.18.0",
        "typescript": "^4.7.4"
    },
    "dependencies": {
        "@vscode/vsce": "^3.3.2"
    }
}